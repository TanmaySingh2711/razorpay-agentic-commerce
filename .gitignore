# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules

# testing
/coverage

# next.js
/.next/
/out/

# OS and sync artefacts. `.DS_Store` alone covered macOS while this repository
# is developed on Windows inside a OneDrive-synced folder, which writes
# `desktop.ini` into directories it manages and `Thumbs.db` when Explorer
# renders a folder. None are useful to a reviewer and all are easy to commit
# by accident with `git add -A`.
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
*.lnk

# Keys and certificates. Never a tracked file, whatever the extension.
*.pem
*.key
*.p12
*.pfx

# Editor and local tool state. Personal to a machine, not to the project.
.vscode/
.idea/
*.swp
*~

# debug. The named patterns are what the package managers write; the general
# rule catches a redirected command's output (`npm run verify > verify.log`),
# which is the way a log file actually tends to appear in this repository.
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# env files - every real secret-bearing file stays untracked.
# .env.example is the single tracked, credential-free template.
.env
.env.*
!.env.example

# local tooling caches
/.vitest

# Prisma client is generated from prisma/schema.prisma at install/build time.
# Migrations are NOT ignored - they are reviewable schema history.
/src/generated

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
