# Installed and generated. Each is rebuilt by a command, never edited by hand.
/node_modules
/.next/
/coverage
# The Prisma client, generated from prisma/schema.prisma by `npm install`.
# Migrations are NOT ignored - they are reviewable schema history.
/src/generated
# Written by Next.js into the project root; its location is not configurable.
next-env.d.ts

# Secrets. Every real env file stays untracked; .env.example is the single
# tracked, credential-free template. Keys and certificates never belong here.
.env
.env.*
!.env.example
*.pem
*.key

# Local state: the Vercel CLI link, command output redirected to a file
# (`npm run verify > verify.log`), editor settings, and what Windows, OneDrive
# and macOS write into a folder they manage.
.vercel
*.log
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
