# =============================================================================
# razorpay-agentic-commerce - environment template
# =============================================================================
# Copy to `.env.local` and fill in real values. NEVER commit a filled-in file.
# This template contains placeholders only - no real credential is ever stored
# in the repository.
#
# Every variable is read exactly once, through the typed/validated config
# boundary in `src/config`. Application code must never touch `process.env`
# directly (enforced by an ESLint rule).
#
# TIERS
#   required-now  : must be present for the app to boot today.
#   required-later: validated lazily, only when the feature that needs it runs.
#                   The Objective 1 foundation boots, builds and tests with
#                   none of these set.
# =============================================================================

# --- Runtime -----------------------------------------------------------------
# required-now (defaulted). Node environment. Set by the framework in practice.
NODE_ENV=development

# required-now (defaulted). Absolute public base URL of this app. Used for
# Razorpay callback/redirect URLs and for building absolute links.
APP_URL=http://localhost:3000

# required-now (defaulted). Minimum severity emitted by the operational logger.
# One of: debug | info | warn | error
LOG_LEVEL=info

# --- Catalog -----------------------------------------------------------------
# required-now (defaulted). Which merchant the public catalog serves. Defaulted
# to the seeded demo merchant, so a fresh clone works with no value set. It is
# configuration and never a request parameter: if a caller could name the
# merchant, every catalog endpoint would become a way to enumerate other
# merchants' products. Not a secret.
CATALOG_MERCHANT_SLUG=keebworks-india

# --- AI provider: Google Gemini (runtime model provider) ---------------------
# required-later. Read ONLY by the Gemini provider adapter behind the AI
# Provider Interface. No other module, and no domain code, ever sees this or the
# provider's response objects. Server-only: never a NEXT_PUBLIC_* variable,
# never sent to the browser, never logged, never written to audit.
GEMINI_API_KEY="your-gemini-api-key"

# required-later (defaulted). Gemini model id used by the buyer agent.
# Centralised here so the model is an environment decision, not a constant
# repeated across source files.
GEMINI_MODEL="gemini-3.6-flash"

# --- Payment provider: Razorpay (Objective: payments) ------------------------
# Read ONLY by the Razorpay adapter behind the Payment Provider Interface.
# The key id and key secret are validated together as their own section, so
# creating a payment order does not depend on the webhook secret below.
# required. Razorpay TEST-mode key id (rzp_test_...). Public-ish - Checkout
# needs it in the browser - but still supplied by the server so the client
# cannot swap merchants. A live key (rzp_live_...) belongs in no file here.
RAZORPAY_KEY_ID=

# required. Razorpay TEST-mode key secret. Server-only, without qualification:
# it authenticates this application to Razorpay over HTTP Basic and signs
# nothing the browser needs. Never NEXT_PUBLIC_*, never in a response, an audit
# record or a log line.
RAZORPAY_KEY_SECRET=

# required-later. Shared secret configured on the Razorpay webhook endpoint.
# Used to verify the HMAC signature of every inbound webhook before the payload
# is trusted or persisted.
RAZORPAY_WEBHOOK_SECRET=

# --- Persistence: PostgreSQL via Prisma --------------------------------------
# required-later. POOLED PostgreSQL connection used by the application at
# runtime. Server-only. Prisma Postgres is the planned hosted provider; any
# PostgreSQL instance works. There is no SQLite tier - development and
# deployment share the same PostgreSQL architecture.
# Shape only - the user and password below are placeholders, not credentials.
DATABASE_URL="postgres://USER:PASSWORD@pooled.db.prisma.io:5432/postgres?sslmode=require"

# required-later, optional. DIRECT (unpooled) PostgreSQL connection used only
# for migrations, because connection poolers generally cannot run DDL. Omit it
# when DATABASE_URL already points at an unpooled instance. Server-only.
# Shape only - USER and PASSWORD are placeholders, not credentials.
DIRECT_URL="postgres://USER:PASSWORD@db.prisma.io:5432/postgres?sslmode=require"

# required-later, optional. Overrides for the isolated database test schema.
# Tests default to DIRECT_URL and a dedicated "agentic_test" PostgreSQL schema,
# so nothing extra is needed. Set this only to run tests against a completely
# separate database. Server-only.
TEST_DIRECT_URL=

# --- Application security -----------------------------------------------------
# required-later. Server-side secret for session and CSRF signing. At least 32
# characters. Generate with: openssl rand -base64 32
APP_SECRET=


# --- Timing windows -----------------------------------------------------------
# All optional: every one of these has a safe default, so nothing needs setting
# to run the system. They are listed because they are financial rules - how long
# a frozen price stands, how long a person has to answer, how long stock is held
# - and a rule nobody can find is a rule nobody can review.
#
# optional. How long a trusted PurchaseQuote stays usable. Default 300 (5 min).
QUOTE_TTL_SECONDS=
# optional. How long a human has to answer an approval request. Default 900 (15 min).
APPROVAL_TTL_SECONDS=
# optional. How long reserved stock is held for one transaction, i.e. the
# checkout window. Default 600 (10 min).
RESERVATION_TTL_SECONDS=


RAZORPAY_KEY_ID="your-razorpay-test-key-id"
RAZORPAY_KEY_SECRET="your-razorpay-test-key-secret"