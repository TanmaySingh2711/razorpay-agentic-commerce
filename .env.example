# =============================================================================
# razorpay-agentic-commerce - environment template
# =============================================================================
# Copy to `.env.local` and fill in real values. NEVER commit a filled-in file.
# This template contains placeholders only - no real credential is ever stored
# in the repository.
#
# Every variable is read exactly once, through the typed/validated config
# boundary in `src/config`. Application code must never touch `process.env`
# directly (enforced by an ESLint rule).
#
# TIERS
#   required-now  : must be present for the app to boot today.
#   required-later: validated lazily, only when the feature that needs it runs.
#                   The Objective 1 foundation boots, builds and tests with
#                   none of these set.
# =============================================================================

# --- Runtime -----------------------------------------------------------------
# required-now (defaulted). Node environment. Set by the framework in practice.
NODE_ENV=development

# required-now (defaulted). Absolute public base URL of this app. Used for
# Razorpay callback/redirect URLs and for building absolute links.
APP_URL=http://localhost:3000

# required-now (defaulted). Minimum severity emitted by the operational logger.
# One of: debug | info | warn | error
LOG_LEVEL=info

# --- AI provider (Objective: Buyer Agent) ------------------------------------
# required-later. Anthropic API key used by the LLM provider adapter only.
# Server-only. Never exposed to the browser, never written to logs or audit.
ANTHROPIC_API_KEY=

# required-later. Model id used by the buyer agent. Overridable per environment
# so the provider adapter is not pinned in code.
ANTHROPIC_MODEL=claude-sonnet-5

# --- Razorpay (Objective: payments) ------------------------------------------
# required-later. Razorpay TEST-mode key id. Public-ish (used by Checkout), but
# still supplied by the server so the client cannot swap merchants.
RAZORPAY_KEY_ID=

# required-later. Razorpay TEST-mode key secret. Server-only. Used for API auth
# and for verifying payment signatures. Must never reach the browser.
RAZORPAY_KEY_SECRET=

# required-later. Shared secret configured on the Razorpay webhook endpoint.
# Used to verify the HMAC signature of every inbound webhook before the payload
# is trusted or persisted.
RAZORPAY_WEBHOOK_SECRET=

# --- Persistence -------------------------------------------------------------
# required-later. Connection string for the transaction/audit datastore.
# Server-only.
DATABASE_URL=
